# ── Aplicación ────────────────────────────────────────────────────────
APP_NAME="Arcillas MX"
APP_ENV=production          # local | production
APP_DEBUG=false             # NUNCA true en producción
APP_URL=https://arcillas.mx
APP_TIMEZONE=America/Mexico_City
APP_KEY=                    # cadena aleatoria de 32+ caracteres

# ── Base de datos MySQL / MariaDB ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u771496034_Arcillas
DB_USER=u771496034_Arcillas
DB_PASS=
DB_CHARSET=utf8mb4

# ── Correo (PHPMailer por SMTP de Hostinger) ──────────────────────────
# MAIL_DRIVER=smtp envía por SMTP; MAIL_DRIVER=log escribe en storage/logs/mail.log
MAIL_DRIVER=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=contacto@arcillas.mx
SMTP_PASS=
SMTP_FROM=contacto@arcillas.mx
SMTP_FROM_NAME="Arcillas MX"
MAIL_TO=contacto@arcillas.mx

# ── Datos de la empresa ───────────────────────────────────────────────
EMPRESA_NOMBRE="ARCILLAS PROTEÍNAS Y DESARROLLOS GARCÍA"
EMPRESA_RFC=APD200702M63
EMPRESA_EMAIL=contacto@arcillas.mx
EMPRESA_TELEFONO=+52 33 1713 5769
EMPRESA_WHATSAPP=523317135769
EMPRESA_DIRECCION="Ciudad de México, México"

# ── Panel ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@arcillas.mx
