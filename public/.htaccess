# ═══════════════════════════════════════════════════════════════════════
# Arcillas MX · .htaccess (Hostinger / Apache)
# Front controller, HTTPS, seguridad y caché.
# ═══════════════════════════════════════════════════════════════════════
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirigir www → sin www (cuando el dominio ya esté apuntando aquí)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Forzar HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Bloquear directorios internos ANTES de servir archivos.
  RewriteRule ^(app|config|database|docs|resources|storage|tests|tools|vendor)/ - [F,L]
  RewriteRule ^(composer\.(json|lock)|README\.md|\.env.*|\.git.*)$ - [F,L]

  # Archivos existentes se sirven directo
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todo lo demás al front controller
  RewriteRule ^ index.php [QSA,L]
</IfModule>

ErrorDocument 404 /index.php

# Protección de archivos sensibles
<FilesMatch "(^\.env|\.env\.|\.sql$|\.md$|\.log$|composer\.(json|lock)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
  # El panel y el API nunca deben indexarse
  <FilesMatch "^(index\.php)$">
    Header always set X-Robots-Tag "noindex, nofollow" env=REDIRECT_STATUS
  </FilesMatch>
</IfModule>

# Compresión de estáticos
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caché de estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# Tamaño máximo de subida (imágenes de materiales)
<IfModule mod_php.c>
  php_value upload_max_filesize 4M
  php_value post_max_size 8M
</IfModule>
